<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XeniaDeck.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:appmodel="using:Windows.ApplicationModel"
    xmlns:services="using:XeniaDeck.Services"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <ScrollView>
        <ScrollView.Content>
            <StackPanel Spacing="{StaticResource SelectorBarItemSpacing}">
                <TextBlock x:Uid="SettingsTextBlock"
                           Style="{StaticResource TitleLargeTextBlockStyle}"/>
 
                <TextBlock x:Uid="AppearanceTextBlock"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Padding="0,24,0,0"/>

                <controls:SettingsExpander x:Uid="AppThemeSettingsExpander"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <RadioButtons x:Name="ThemeRadioButtons" SelectionChanged="ThemeRadioButtons_SelectionChanged">
                                <RadioButton x:Uid="LightRadioButton" Content="Light" Tag="Light"/>
                                <RadioButton x:Uid="DarkRadioButton" Content="Dark" Tag="Dark"/>
                                <RadioButton x:Uid="UseSystemSettingRadioButton" Content="Use system setting" Tag="Default"/>
                            </RadioButtons>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <StackPanel>

                    <controls:SettingsCard x:Uid="LanguageSettingsCard"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xF2B7;}">
                        <ComboBox x:Name="LanguageComboBox" 
                                  Width="200"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="services:LanguageOption">
                                    <TextBlock Text="{x:Bind DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls:SettingsCard>
                    
                    <InfoBar x:Uid="LanguageInfoBar"
                             IsIconVisible="True"
                             IsOpen="{x:Bind _appStateService.IsLanguageChanged, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Warning">
                        <InfoBar.ActionButton>
                            <Button x:Name="RestartButton"
                                    x:Uid="RestartButton"
                                    Content="Restart"
                                    Click="RestartButton_Click"/>
                        </InfoBar.ActionButton>
                    </InfoBar>

                </StackPanel>

                <TextBlock x:Uid="AboutTextBlock"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Padding="0,24,0,0"/>

                <controls:SettingsExpander x:Uid="AppInfoSettingsExpander" Grid.Row="0"
                                           Header="{x:Bind appmodel:AppInfo.Current.DisplayInfo.DisplayName}"
                                           Content="{x:Bind AppVersion}">
                    <controls:SettingsExpander.HeaderIcon>
                        <ImageIcon Source="/Assets/StoreLogo.png"/>
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Left">
                            <StackPanel Margin="0,4,0,6"
                                        Orientation="Vertical"
                                        Spacing="0">

                                <TextBlock x:Uid="LibrariesUsedTextBlock"
                                           Margin="12,0,0,7"/>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/microsoft/microsoft-ui-XAML">
                                        <TextBlock Text="WinUI3"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="UI Framework" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/CommunityToolkit/dotnet">
                                        <TextBlock Text="CommunityToolkit.Mvvm"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="Model-View-ViewModel library" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/CommunityToolkit/Windows">
                                        <TextBlock Text="CommunityToolkit.WinUI"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="Helper functions, extensions, and custom controls for WinUI3" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/dotnet/extensions">
                                        <TextBlock Text="Microsoft.Extentions"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="Dependency injection, configuration, logging, and hosting" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/octokit/octokit.net">
                                        <TextBlock Text="Octokit"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="API for interfacing with GitHub" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/serilog/serilog">
                                        <TextBlock Text="Serilog"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="Logging to file on disk" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/adamhathcock/sharpcompress">
                                        <TextBlock Text="SharpCompress"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="Extract compressed files" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/Team-Resurgent/XboxToolkit">
                                        <TextBlock Text="XboxToolkit"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="Reading TitleIDs from ROM files" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/TestableIO/System.IO.Abstractions">
                                        <TextBlock Text="System.IO.Abstractions"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="File IO abstraction for better testability" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/richardszalay/mockhttp">
                                        <TextBlock Text="RichardSzalay.MockHttp"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="HttpClient mocking library" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <HyperlinkButton NavigateUri="https://github.com/nsubstitute/NSubstitute">
                                        <TextBlock Text="NSubstitute"/>
                                    </HyperlinkButton>

                                    <TextBlock Text="General mocking library" VerticalAlignment="Center" Padding="0,0,0,2"/>
                                </StackPanel>

                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock Margin="0,18,0,18">
                   <Hyperlink UnderlineStyle="None"
                              NavigateUri="https://github.com/Xenia-Deck/Xenia-Deck/issues">
                       <Run x:Uid="SendFeedbackRun"/>
                   </Hyperlink>
                </TextBlock>
                
                <TextBlock>
                    <Run x:Uid="ContributeRun"/>
                    <Run Text="{x:Bind appmodel:AppInfo.Current.DisplayInfo.DisplayName}"/><Run x:Uid="CheckOutRun"/>
                    
                    <Hyperlink UnderlineStyle="None"
                               NavigateUri="https://github.com/Xenia-Deck/Xenia-Deck">
                        <Run Text="GitHub"/>
                    </Hyperlink><Run Text="."/>
                </TextBlock>
                
            </StackPanel>
        </ScrollView.Content>
    </ScrollView>
</Page>
