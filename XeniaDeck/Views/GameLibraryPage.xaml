<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XeniaDeck.Views.GameLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XeniaDeck.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:XeniaDeck.Core.Models"
    xmlns:selectors="using:XeniaDeck.Selectors"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d"
    Loaded="{x:Bind _viewModel.LoadGamesAsync}">

    <Page.Resources>
        <StandardUICommand x:Key="DeleteGameCommand" 
                           Kind="Delete"
                           Command="{x:Bind _viewModel.DeleteGameCommand}"/>

        <StandardUICommand x:Key="PlayGameCommand"
                           Command="{x:Bind _viewModel.PlayGameCommand}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Padding="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Uid="Games"
                       Style="{StaticResource TitleLargeTextBlockStyle}"
                       Grid.Column="0"/>

            <Button Grid.Column="1" HorizontalAlignment="Right">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon FontSize="16" Glyph="&#xE710;" />
                        <TextBlock x:Uid="AddGamesTextBlock"/>
                    </StackPanel>
                </Button.Content>

                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutItem x:Uid="AddGamesFromFileMenuFlyoutItem" Command="{x:Bind _viewModel.AddGamesCommand}"/>
                        <MenuFlyoutItem x:Uid="AddGamesFromCustomFolderMenuFlyoutItem" Command="{x:Bind _viewModel.AddGamesFromFolderCommand}"/>
                        <MenuFlyoutItem x:Uid="OpenGamesFolderMenuFlyoutItem" Command="{x:Bind _viewModel.OpenGamesFolderCommand}"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <ItemsView Grid.Row="1"
                   ItemsSource="{x:Bind _viewModel.Games}"
                   IsItemInvokedEnabled="True"
                   SelectionMode="None">

            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="models:Game">
                    <ItemContainer Width="200"
                                   Height="270">

                        <interactivity:Interaction.Behaviors>
                            <interactivity:EventTriggerBehavior EventName="Tapped">
                                <interactivity:InvokeCommandAction Command="{StaticResource PlayGameCommand}"
                                                                   CommandParameter="{x:Bind}"/>
                            </interactivity:EventTriggerBehavior>
                        </interactivity:Interaction.Behaviors>

                        <ItemContainer.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Command="{StaticResource DeleteGameCommand}"
                                                CommandParameter="{x:Bind}">
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ItemContainer.ContextFlyout>

                        <Image Source="{x:Bind SimpleGameInfo.Boxart}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>

            <ItemsView.Layout>
                <UniformGridLayout MinColumnSpacing="10" MinRowSpacing="10"/>
            </ItemsView.Layout>
        </ItemsView>
    </Grid>
</Page>