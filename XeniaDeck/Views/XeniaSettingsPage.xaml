<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XeniaDeck.Views.XeniaSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:model="using:Tomlyn.Model"
    xmlns:viewmodels="using:XeniaDeck.Core.ViewModels"
    xmlns:selectors="using:XeniaDeck.Selectors"
    xmlns:System="using:System"
    mc:Ignorable="d"
    Loaded="{x:Bind _viewModel.LoadSettingsAsync}">

    <Page.Resources>
        <selectors:TomlSettingTemplateSelector x:Key="TomlSettingTemplateSelector">

            <selectors:TomlSettingTemplateSelector.BooleanTemplate>
                <DataTemplate x:DataType="viewmodels:TomlSetting">
                    <controls:SettingsCard Header="{x:Bind Key}"
                                           Description="{x:Bind Description}">
                        <ToggleSwitch AutomationProperties.Name="simple ToggleSwitch"
                                      IsOn="{x:Bind (System:Boolean)Value}"/>
                    </controls:SettingsCard>
                </DataTemplate>
            </selectors:TomlSettingTemplateSelector.BooleanTemplate>

            <selectors:TomlSettingTemplateSelector.LongTemplate>
                <DataTemplate x:DataType="viewmodels:TomlSetting">
                    <controls:SettingsCard Header="{x:Bind Key}"
                                           Description="{x:Bind Description}">
                        <!-- TODO: use a NumberBox instead of input things -->
                        <TextBox Text="{x:Bind (System:Int64)Value}"
                                 VerticalAlignment="Center"/>
                    </controls:SettingsCard>
                </DataTemplate>
            </selectors:TomlSettingTemplateSelector.LongTemplate>

            <selectors:TomlSettingTemplateSelector.DoubleTemplate>
                <DataTemplate x:DataType="viewmodels:TomlSetting">
                    <controls:SettingsCard Header="{x:Bind Key}"
                                           Description="{x:Bind Description}">
                        <!-- TODO: use a NumberBox instead of input things -->
                        <TextBox Text="{x:Bind (System:Double)Value}"
                                 VerticalAlignment="Center"/>
                    </controls:SettingsCard>
                </DataTemplate>
            </selectors:TomlSettingTemplateSelector.DoubleTemplate>

            <selectors:TomlSettingTemplateSelector.StringTemplate>
                <DataTemplate x:DataType="viewmodels:TomlSetting">
                    <controls:SettingsCard Header="{x:Bind Key}"
                                           Description="{x:Bind Description}">
                        <TextBox Text="{x:Bind (System:String)Value}"
                                 VerticalAlignment="Center"/>
                    </controls:SettingsCard>
                </DataTemplate>
            </selectors:TomlSettingTemplateSelector.StringTemplate>

        </selectors:TomlSettingTemplateSelector>
    </Page.Resources>
    
    <Grid RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Xenia Settings (Under construction)"
                   Style="{StaticResource TitleLargeTextBlockStyle}"
                   Grid.Row="0"/>
        
        <!-- TODO: follow the selectorbar tutorial to implement this properly -->
        <SelectorBar Grid.Row="1">
            <SelectorBarItem Text="General" IsSelected="True">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Display">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE7F4;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Graphics">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE964;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Input">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE7FC;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
            <SelectorBarItem Text="Audio">
                <SelectorBarItem.Icon>
                    <FontIcon Glyph="&#xE7F6;" />
                </SelectorBarItem.Icon>
            </SelectorBarItem>
        </SelectorBar>

        <Frame Grid.Row="2"
               x:Name="ContentFrame"
               IsNavigationStackEnabled="False" />
    </Grid>
</Page>
